<Window x:Class="TroybinEditor.Views.AddEmitterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Emitter" Height="170" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add New Emitter" FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Emitter Name" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox"
                     Style="{StaticResource ModernTextBoxStyle}"
                     FontFamily="Consolas" FontSize="12"
                     Text="NewEmitter"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="{StaticResource SurfaceLightBrush}"
                    Padding="16,7" Margin="0,0,8,0"/>
            <Button Content="Add Emitter" Click="Ok_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Padding="16,7" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>

