<Window x:Class="TroybinEditor.Views.AddEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Entry" Height="220" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Add New Entry" FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"/>

        <!-- Key -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Field Name (key)" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="KeyBox"
                     Style="{StaticResource ModernTextBoxStyle}"
                     FontFamily="Consolas" FontSize="12"
                     Text="p-texture"/>
        </StackPanel>

        <!-- Value -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Value" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="ValueBox"
                     Style="{StaticResource ModernTextBoxStyle}"
                     FontFamily="Consolas" FontSize="12"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="{StaticResource SurfaceLightBrush}"
                    Padding="16,7" Margin="0,0,8,0"/>
            <Button Content="Add Entry" Click="Ok_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Padding="16,7" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>

