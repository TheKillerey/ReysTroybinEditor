<Window x:Class="TroybinEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TroybinEditor.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Accent button (delete / danger) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF6B6B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid row style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#223B82F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#0AFFFFFF"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="*"/>     <!-- content -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════
             TOOLBAR
        ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceLightBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="12,8">

                <!-- App logo / title -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,24,0">
                    <Border Width="28" Height="28" Background="{StaticResource PrimaryBrush}"
                            CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Rey's Troybin Editor" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- File menu -->
                <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center">
                    
                </Menu>

                <!-- Quick buttons -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0">
                    <!-- File -->
                    <Button Content="📂  Open"    Command="{Binding OpenFileCommand}"
                            Style="{StaticResource ModernButtonStyle}" Padding="12,6" Margin="0,0,4,0"/>
                    <Button Content="💾  Save"    Command="{Binding SaveFileCommand}"
                            Style="{StaticResource ModernButtonStyle}" Padding="12,6" Margin="0,0,4,0"/>
                    <Button Content="Save As…"   Command="{Binding SaveAsCommand}"
                            Style="{StaticResource ModernButtonStyle}" Padding="12,6" Margin="0,0,12,0"/>

                    <!-- Emitter actions -->
                    <Rectangle Width="1" Fill="{StaticResource SurfaceLightBrush}" Margin="0,4,12,4"/>
                    <Button Content="➕ Emitter"  Command="{Binding AddEmitterCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="{StaticResource AccentBrush}" Padding="12,6" Margin="0,0,4,0"
                            ToolTip="Add a new emitter to this file"/>
                    <Button Content="🗑 Emitter"  Command="{Binding DeleteSelectedParticleCommand}"
                            Style="{StaticResource DangerButtonStyle}" Padding="12,6" Margin="0,0,12,0"
                            ToolTip="Delete the selected emitter"/>

                    <!-- Entry actions -->
                    <Rectangle Width="1" Fill="{StaticResource SurfaceLightBrush}" Margin="0,4,12,4"/>
                    <Button Content="➕ Entry"    Command="{Binding AddEntryCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="{StaticResource AccentBrush}" Padding="12,6" Margin="0,0,4,0"
                            ToolTip="Add a key=value entry to the selected emitter"/>
                    <Button Content="🗑 Entry"    Command="{Binding DeleteSelectedEntryCommand}"
                            Style="{StaticResource DangerButtonStyle}" Padding="12,6" Margin="0,0,4,0"
                            ToolTip="Delete the selected entry"/>
                    <Button Content="↩ Reset"    Command="{Binding ResetSelectedParticleCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="{StaticResource SurfaceLightBrush}" Padding="12,6" Margin="0,0,12,0"
                            ToolTip="Reset selected emitter to original (loaded) values (Ctrl+Z)"/>

                    <!-- Convert -->
                    <Rectangle Width="1" Fill="{StaticResource SurfaceLightBrush}" Margin="0,4,12,4"/>
                    <Button Content="🔄 Convert Tool" Click="OpenConverter_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="{StaticResource SurfaceLightBrush}" Padding="12,6"
                            ToolTip="Open standalone Troybin ↔ Text batch converter"/>
                </StackPanel>

                <!-- Loading indicator -->
                <TextBlock DockPanel.Dock="Right" Text="⏳ Loading…"
                           Foreground="{StaticResource AccentBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             MAIN CONTENT  (3-column layout)
        ══════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"   MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Particle list ─────────────────────────────── -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Padding="12,10,12,8"
                            BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="PARTICLES" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} emitters">
                                        <Binding Path="Particles.Count" Mode="OneWay"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                        </StackPanel>
                    </Border>

                    <!-- Particle list -->
                    <ListBox ItemsSource="{Binding Particles}"
                             SelectedItem="{Binding SelectedParticle}"
                             Style="{StaticResource ModernListBoxStyle}"
                             Background="Transparent" BorderThickness="0"
                             Margin="0" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ParticleViewModel}">
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                            Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PreviewLine}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ── SPLITTER ─────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource SurfaceLightBrush}" Cursor="SizeWE"/>

            <!-- ── CENTER: String DataGrid ──────────────────────────────── -->
            <DockPanel Grid.Column="2" Background="{StaticResource BackgroundBrush}">

                <!-- Center header -->
                <Border DockPanel.Dock="Top" Padding="16,12"
                        BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="0,0,0,1"
                        Background="{StaticResource SurfaceBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceLightBrush}"
                                CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding SelectedParticle.StringCount, FallbackValue='0', Mode=OneWay}"/>
                                <Run Text=" strings"/>
                            </TextBlock>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="STRING EDITOR" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource TextBrush}">
                                <Run Text="Particle: " Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding SelectedParticle.Name, FallbackValue='(none selected)'}"
                                     FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- No-selection placeholder -->
                <StackPanel DockPanel.Dock="Top"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,60,0,0"
                            Visibility="{Binding SelectedParticle, Converter={StaticResource NullToVisConverter}}">
                    <TextBlock Text="⚡" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{StaticResource SurfaceLightBrush}"/>
                    <TextBlock Text="Select a particle on the left" FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="or open a .troybin file to get started"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                    <DataGrid DockPanel.Dock="Top"
                              ItemsSource="{Binding SelectedParticle.Entries}"
                              SelectedItem="{Binding SelectedEntry}"
                              Visibility="{Binding SelectedParticle, Converter={StaticResource NotNullToVisConverter}}">
                        <DataGrid.Columns>

                            <!-- # index -->
                            <DataGridTemplateColumn Header="#" Width="44" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StringEntry}">
                                        <Border Background="{StaticResource SurfaceLightBrush}"
                                                CornerRadius="3" Padding="4,2" Margin="6,4"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Index}" FontSize="10"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Field Name (Key) -->
                            <DataGridTemplateColumn Header="Field" Width="200" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StringEntry}">
                                        <TextBlock Text="{Binding Key}" FontSize="11"
                                                   FontFamily="Consolas" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsName}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Value (editable) -->
                            <DataGridTemplateColumn Header="Value" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StringEntry}">
                                        <TextBlock Text="{Binding Value}" Padding="8,5"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate DataType="{x:Type vm:StringEntry}">
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 FontFamily="Consolas" FontSize="12"
                                                 Padding="8,4" Margin="2" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Type badge -->
                            <DataGridTemplateColumn Header="Type" Width="80" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:StringEntry}">
                                        <Border Padding="6,2" Margin="6,3" HorizontalAlignment="Left"
                                                CornerRadius="3"
                                                Background="{Binding Value, Converter={StaticResource ValueTypeToBrushConverter}}">
                                            <TextBlock Text="{Binding Value, Converter={StaticResource ValueTypeToLabelConverter}}"
                                                       FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
            </DockPanel>

            <!-- ── SPLITTER ─────────────────────────────────────────── -->
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource SurfaceLightBrush}" Cursor="SizeWE"/>

            <!-- ── RIGHT: Info / details panel ───────────────────────── -->
            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Padding="14,10"
                            BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="DETAILS" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,12">

                            <!-- File info card -->
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                                    Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="FILE INFO" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding FileInfoText}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>

                            <!-- Selected particle card -->
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                                    Padding="12" Margin="0,0,0,12"
                                    Visibility="{Binding SelectedParticle, Converter={StaticResource NotNullToVisConverter}}">
                                <StackPanel DataContext="{Binding SelectedParticle}">
                                    <TextBlock Text="SELECTED PARTICLE" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                    <!-- Name -->
                                    <TextBlock Text="Name" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             FontFamily="Consolas" Margin="0,0,0,12"/>

                                    <!-- Typed props -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Texture"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   Margin="0,0,8,6" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Texture, FallbackValue='—'}"
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Consolas"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mesh"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   Margin="0,0,8,6" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding Mesh, FallbackValue='—'}"
                                                   Foreground="{StaticResource TextBrush}" FontFamily="Consolas"
                                                   FontSize="11" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Blend"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   Margin="0,0,8,6" VerticalAlignment="Center"/>
                                        <Border Grid.Row="2" Grid.Column="1" CornerRadius="3" Padding="6,2"
                                                Background="{StaticResource SurfaceLightBrush}"
                                                HorizontalAlignment="Left" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding BlendMode, FallbackValue='—'}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Strings"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   Text="{Binding StringCount}"
                                                   Foreground="{StaticResource TextBrush}" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Color keyframes card -->
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                                    Padding="12"
                                    Visibility="{Binding SelectedParticle, Converter={StaticResource NotNullToVisConverter}}">
                                <StackPanel DataContext="{Binding SelectedParticle}">
                                    <TextBlock Text="QUICK HELP" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" LineHeight="18"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run FontWeight="Bold" Foreground="{StaticResource AccentBrush}">Double-click</Run>
                                        <Run> a Value cell to edit it inline.</Run>
                                        <LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">Color keyframes</Run>
                                        <Run> use the format:</Run>
                                        <LineBreak/>
                                        <Run FontFamily="Consolas" Foreground="{StaticResource TextBrush}">T R G B A</Run>
                                        <LineBreak/>
                                        <Run>e.g. </Run>
                                        <Run FontFamily="Consolas" Foreground="{StaticResource TextBrush}">0.0 1 1 1 1</Run>
                                        <LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">Texture</Run>
                                        <Run> filenames end in </Run>
                                        <Run FontFamily="Consolas" Foreground="{StaticResource TextBrush}">.dds</Run>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">Mesh</Run>
                                        <Run> filenames end in </Run>
                                        <Run FontFamily="Consolas" Foreground="{StaticResource TextBrush}">.scb</Run>
                                        <LineBreak/>
                                        <LineBreak/>
                                        <Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">Blend modes:</Run>
                                        <Run FontFamily="Consolas" Foreground="{StaticResource TextBrush}"> Simple, Complex, Add</Run>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════
             STATUS BAR
        ══════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceLightBrush}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                    <Run Text="Particles: "/><Run Text="{Binding Particles.Count, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

