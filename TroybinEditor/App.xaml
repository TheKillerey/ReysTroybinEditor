<Application x:Class="TroybinEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TroybinEditor"
             xmlns:conv="clr-namespace:TroybinEditor.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters available application-wide -->
            <conv:NullToVisibilityConverter      x:Key="NullToVisConverter"/>
            <conv:NotNullToVisibilityConverter   x:Key="NotNullToVisConverter"/>
            <conv:BoolToVisibilityConverter      x:Key="BoolToVisConverter"/>
            <conv:ValueTypeToBrushConverter      x:Key="ValueTypeToBrushConverter"/>
            <conv:ValueTypeToLabelConverter      x:Key="ValueTypeToLabelConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
